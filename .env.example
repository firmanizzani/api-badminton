# Neon PostgreSQL (pooled connection string)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# JWT signing secret (random 64+ chars)
JWT_SECRET="change-me-to-a-long-random-string"

# API port (lokal saja; Vercel tidak pakai ini)
PORT=3000

# Origin frontend produksi untuk CORS + cookie secure.
# Produksi: https://<frontend>.vercel.app
# Lokal:    http://localhost:4321
FRONTEND_URL="http://localhost:4321"

# HMAC secret untuk verifikasi signature payment webhook
WEBHOOK_SECRET="change-me-to-a-long-random-string"
